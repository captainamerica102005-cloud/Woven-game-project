@onready var screen_tex: TextureRect = $ScreenContainer
@onready var game_vp: SubViewport = $GameViewport

func _ready() -> void:
	screen_tex.texture = game_vp.get_texture()

	game_vp.size_2d_override = Vector2i(1152, 648)
	game_vp.size_2d_override_stretch = true
	game_vp.gui_embed_subwindows = true
	game_vp.handle_input_locally = true

func _process(_delta: float) -> void:
	# 🟢 THE MANUAL HOVER ENFORCER:
	# Safely look for your active scrollbar node anywhere inside the settings menu
	var v_scroll = game_vp.find_child("VideoList", true, false)
	if v_scroll and v_scroll.has_method("get_v_scroll_bar"):
		var bar = v_scroll.get_v_scroll_bar()
		if bar:
			# Get the scrollbar's real physical box position on your 1152x648 UI canvas
			var bar_rect = Rect2(bar.global_position, bar.size)
			# Get your live forwarded mouse position inside the viewport
			var mouse_pos = game_vp.get_mouse_position()
			
			# If your mouse cursor is physically colliding with the red scrollbar box:
			if bar_rect.has_point(mouse_pos):
				# Force the engine to draw the 'grabber_highlight' texture instantly!
				bar.mouse_filter = Control.MOUSE_FILTER_STOP
				# This fakes a system focus grab so the texture pops red
				if bar.theme_type_variation != "VScrollBar_Hovered":
					bar.theme_type_variation = "VScrollBar_Hovered"
			else:
				# Drop back to your normal texture state when the mouse walks away
				if bar.theme_type_variation == "VScrollBar_Hovered":
					bar.theme_type_variation = ""

func _input(event: InputEvent) -> void:
	if event is InputEventMouse:
		var mouse_event := event as InputEventMouse
		var tex_rect := _get_drawn_texture_rect()

		var pos_in_screen := mouse_event.position - screen_tex.position
		if not tex_rect.has_point(pos_in_screen):
			return

		var local_event := mouse_event.duplicate() as InputEventMouse
		local_event.position = (
			(pos_in_screen - tex_rect.position)
			/ tex_rect.size
			* Vector2(game_vp.size)
		)
		local_event.global_position = local_event.position

		if event is InputEventMouseMotion:
			var motion := event as InputEventMouseMotion
			var local_motion := local_event as InputEventMouseMotion
			local_motion.relative = (
				motion.relative / tex_rect.size * Vector2(game_vp.size)
			)

		game_vp.push_input(local_event)
	else:
		game_vp.push_input(event)

func _get_drawn_texture_rect() -> Rect2:
	var container_size := screen_tex.size
	var vp_size := Vector2(game_vp.size)
	if vp_size.x <= 0.0 or vp_size.y <= 0.0:
		return Rect2(Vector2.ZERO, container_size)
	var scale_factor := minf(container_size.x / vp_size.x, container_size.y / vp_size.y)
	var drawn_size := vp_size * scale_factor
	var offset := (container_size - drawn_size) * 0.5
	return Rect2(offset, drawn_size)

